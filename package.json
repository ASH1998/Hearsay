{
  "name": "hearsay",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "doctor": "powershell -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "play": "powershell -ExecutionPolicy Bypass -File scripts/play.ps1",
    "test": "powershell -ExecutionPolicy Bypass -File scripts/test.ps1",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File scripts/migrate.ps1",
    "db:test": "powershell -ExecutionPolicy Bypass -File scripts/test-database.ps1",
    "api:export": "tools/uv/uv.exe --cache-dir .cache/uv run --python tools/python/cpython-3.12.13-windows-x86_64-none/python.exe python scripts/export_openapi.py",
    "api:generate": "corepack pnpm@11.9.0 api:export && corepack pnpm@11.9.0 --filter @hearsay/web generate:api",
    "typecheck": "corepack pnpm@11.9.0 --filter @hearsay/web typecheck",
    "lint": "corepack pnpm@11.9.0 --filter @hearsay/web lint",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts/test-e2e.ps1",
    "test:e2e:release": "powershell -ExecutionPolicy Bypass -File scripts/test-e2e.ps1 -Release",
    "replay:export": "powershell -ExecutionPolicy Bypass -File scripts/export-replays.ps1",
    "replay:build": "powershell -ExecutionPolicy Bypass -File scripts/build-replay-site.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
