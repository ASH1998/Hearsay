# Runtime
HEARSAY_ENV=development
HEARSAY_LOG_LEVEL=INFO
HEARSAY_API_HOST=127.0.0.1
HEARSAY_API_PORT=8000
HEARSAY_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CockroachDB Cloud (supply the user-managed development instance)
HEARSAY_PERSISTENCE_BACKEND=cockroachdb
DATABASE_URL=cockroachdb+psycopg://USER:PASSWORD@HOST:26257/hearsay?sslmode=verify-full
HEARSAY_TEST_DATABASE_URL=cockroachdb+psycopg://USER:PASSWORD@HOST:26257/hearsay_test?sslmode=verify-full
HEARSAY_DATABASE_POOL_SIZE=5
HEARSAY_TRANSACTION_MAX_RETRIES=4

# Existing Cockroach Cloud command exports are also supported when DATABASE_URL
# is omitted. Prefer the explicit COCKROACH_* names for new environments.
COCKROACH_USERNAME=
COCKROACH_PASSWORD=
COMMAND_TO_CREATE_CERT=
COMMAND_TO_CONNECT=

# Development LLM adapter (optional; deterministic fallback is the default)
HEARSAY_LLM_PROVIDER=fallback
MODAL_PROXY_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
HEARSAY_MODAL_MODEL=thinkingmachines/Inkling-NVFP4

# Future production inference
AWS_REGION=
HEARSAY_BEDROCK_PRINCIPAL_MODEL=
HEARSAY_BEDROCK_AMBIENT_MODEL=

# Development-only Director controls
HEARSAY_DIRECTOR_ENABLED=false
HEARSAY_DIRECTOR_TOKEN=

# Repository-local tooling
UV_PROJECT_ENVIRONMENT=.venv
UV_PYTHON_INSTALL_DIR=tools/python
UV_CACHE_DIR=.cache/uv
UV_TOOL_DIR=tools/uv-tools
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright
