# Runtime
HEARSAY_ENV=development
HEARSAY_LOG_LEVEL=INFO
HEARSAY_API_HOST=127.0.0.1
HEARSAY_API_PORT=8000
HEARSAY_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CockroachDB Cloud (supply the user-managed development instance)
HEARSAY_PERSISTENCE_BACKEND=cockroachdb
DATABASE_URL=cockroachdb+psycopg://USER:PASSWORD@HOST:26257/hearsay?sslmode=verify-full
HEARSAY_TEST_DATABASE_URL=cockroachdb+psycopg://USER:PASSWORD@HOST:26257/hearsay_test?sslmode=verify-full
HEARSAY_DATABASE_POOL_SIZE=5
HEARSAY_TRANSACTION_MAX_RETRIES=4

# Independent read-only Town Historian. `auto` uses the official CockroachDB
# Cloud Managed MCP endpoint only when both independent credentials exist;
# otherwise it returns a conspicuously labeled direct-database fallback that is
# never counted as sponsor proof.
HEARSAY_HISTORIAN_PROVIDER=auto
HEARSAY_HISTORIAN_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_CLUSTER_ID=
COCKROACH_MCP_API_KEY=
HEARSAY_HISTORIAN_DATABASE=hearsay
HEARSAY_HISTORIAN_TIMEOUT_SECONDS=20

# Existing Cockroach Cloud command exports are also supported when DATABASE_URL
# is omitted. Prefer the explicit COCKROACH_* names for new environments.
COCKROACH_USERNAME=
COCKROACH_PASSWORD=
COMMAND_TO_CREATE_CERT=
COMMAND_TO_CONNECT=

# Inference provider. Keep `fallback` for local/offline work so no paid model is
# invoked. The deployed demo must explicitly set `bedrock`; `auto` prefers a
# configured Bedrock model, then Modal, then the deterministic provider.
HEARSAY_LLM_PROVIDER=fallback
AWS_REGION=
# Claude Haiku 4.5 Converse model ID. Keep this configurable because Bedrock
# model availability and inference-profile requirements vary by region.
# HEARSAY_BEDROCK_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
HEARSAY_BEDROCK_MODEL=
MODAL_PROXY_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Required whenever the Modal provider is used. There is deliberately no default:
# the id must match what MODAL_PROXY_URL actually serves (`GET /v1/models`), and a
# wrong id fails every call, which SafeInferenceProvider silently degrades to the
# deterministic rule engine. Leave blank to keep Modal unconfigured.
HEARSAY_MODAL_MODEL=
HEARSAY_INFERENCE_TIMEOUT_SECONDS=45
HEARSAY_INFERENCE_MAX_ATTEMPTS=2

# Local semantic embeddings. Auto uses BGE-small and falls back safely if the
# model cannot load; set fallback for a credential/network-free test runtime.
HEARSAY_EMBEDDING_PROVIDER=auto
HEARSAY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HEARSAY_EMBEDDING_CACHE_DIR=.cache/huggingface

# Development-only Director controls
HEARSAY_DIRECTOR_ENABLED=false
HEARSAY_DIRECTOR_TOKEN=

# Repository-local tooling
UV_PROJECT_ENVIRONMENT=.venv
UV_PYTHON_INSTALL_DIR=tools/python
UV_CACHE_DIR=.cache/uv
UV_TOOL_DIR=tools/uv-tools
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright
